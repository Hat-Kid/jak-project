    :walk-acceleration (meters 1)
    :walk-turning-acceleration (meters 25)
    :maximum-rotation-rate (degrees 2880)
    :notice-nav-radius (meters 2)
    :frustration-distance (meters 8)
    :frustration-time (seconds 4)
    :blocked-time (seconds 0.3)
    :circle-dist-lo 20480.0
    :circle-dist-hi 61440.0
    :nav-mesh #f
    )
  )

(set! (-> *babak-enemy-nav-enemy-info* fact-defaults) *fact-info-enemy-defaults*)

(defbehavior babak-enemy-play-win-anim babak-enemy ((speed float))
  (ja-channel-push! 1 (seconds 0.1))
  (ja-no-eval :group! babak-enemy-win-ja :num! (seek! (ja-aframe 68.0 0) speed) :frame-num 0.0)
  (until (ja-done? 0)
    (suspend)
    (ja :num! (seek! (ja-aframe 68.0 0) speed))
    )
  (none)
  )

(defstate active (babak-enemy)
  :virtual #t
  :code (behavior ()
    (when (ja-group? babak-enemy-give-up-hop-ja)
      (ja-channel-push! 1 (seconds 0.15))
      (ja-no-eval :group! babak-enemy-walk-ja :num! (seek!) :frame-num (ja-aframe 12.0 0))
      (until (ja-done? 0)
        (suspend)
        (ja :num! (seek!))
        )
      )
    (let ((code (-> (find-parent-state) code)))
      (if code
          (code)
          )
      )
    )
  )

(defstate hostile (babak-enemy)
  :virtual #t
  :code (behavior ()
    (let ((anim-speed (rnd-float-range self 0.9 1.1)))
      (cond
        ((ja-group? babak-enemy-jump-land-ja)
         (ja-no-eval :num! (seek!))
         (ja-channel-push! 1 (seconds 0.17))
         (ja-no-eval :group! (-> self draw art-group data (-> self enemy-info hostile-anim))
                     :num! (seek! max anim-speed)
                     :frame-num 0.0
                     )
         (until (ja-done? 0)
           (ja-blend-eval)
           (suspend)
           (ja :num! (seek! max anim-speed))
           )
         )
        (else
          (ja-channel-push! 1 (seconds 0.2))
          (ja :group! (-> self draw art-group data (-> self enemy-info hostile-anim)))
          (ja :num-func num-func-identity :frame-num 0.0)
          )
        )
      (until #f
        (suspend)
        (ja :num! (loop! anim-speed))
        )
      )
    #f
    )
  )

(defstate stare (babak-enemy)
  :virtual #t
  :code (behavior ()
    (ja-channel-push! 1 (seconds 0.1))
    (let ((anim-speed (rnd-float-range self 0.8 1.2)))
      (when (rnd-chance? self 0.5)
        (babak-enemy-play-win-anim anim-speed)
        )
      (until #f
        (when (not (pointing-toward-focus? self 2730.6667 #t))
          (logior! (-> self enemy-flags) (enemy-flag ef38))
          (ja-no-eval :num! (loop!))
          (ja-channel-push! 1 (seconds 0.2))
          (ja :group! babak-enemy-turn-ja)
          (ja :num-func num-func-identity :frame-num 0.0)
          (until (pointing-toward-focus? self 1820.4445 #t)
            (ja-blend-eval)
            (suspend)
            (ja :num! (loop! 0.75))
            )
          (logclear! (-> self enemy-flags) (enemy-flag ef38))
          )
        (if (not (ja-group? babak-enemy-idle-ja))
            (ja-channel-push! 1 (seconds 0.2))
            )
        (ja-no-eval :group! babak-enemy-idle-ja :num! (seek! max anim-speed) :frame-num 0.0)
        (until (ja-done? 0)
          (suspend)
          (ja :num! (seek! max anim-speed))
          )
        (when (rnd-chance? self 0.3)
          (babak-enemy-play-win-anim anim-speed)
          )
        )
      )
    #f
    )
  )

(defstate stop-chase (babak-enemy)
  :virtual #t
  :code (behavior ()
    (ja-channel-push! 1 (seconds 0.15))
    (when (pointing-toward-focus? self 12743.111 #f)
      (ja-no-eval :group! babak-enemy-give-up-ja :num! (seek!) :frame-num 0.0)
      (until (ja-done? 0)
        (suspend)
        (ja :num! (seek!))
        )
      )
    (ja-no-eval :group! babak-enemy-give-up-hop-ja :num! (seek!) :frame-num 0.0)
    (until (ja-done? 0)
      (suspend)
      (ja :num! (seek!))
      )
    (ja-channel-push! 1 (seconds 0.2))
    (ja :group! (-> self draw art-group data (-> self enemy-info walk-anim)))
    (ja :num-func num-func-identity :frame-num 0.0)
    (let ((anim-speed (rnd-float-range self 0.8 1.2)))
      (until #f
        (suspend)
        (ja :num! (loop! anim-speed))
        )
      )
    #f
    )
  )

(defmethod init-enemy-collision! ((this babak-enemy))
  "Typical place to construct collision shapes"
  (let ((cshape (new 'process 'collide-shape-moving this (collide-list-enum usually-hit-by-player))))
    (set! (-> cshape dynam) (copy *standard-dynamics* 'process))
    (set! (-> cshape reaction) cshape-reaction-default)
    (set! (-> cshape no-reaction)
          (the-as (function collide-shape-moving collide-query vector vector object) nothing)
          )
    (let ((body-group (new 'process 'collide-shape-prim-group cshape (the-as uint 3) 0)))
      (set! (-> cshape total-prims) (the-as uint 4))
      (set! (-> body-group prim-core collide-as) (collide-spec enemy))
      (set! (-> body-group prim-core collide-with)
            (collide-spec backgnd jak bot crate obstacle hit-by-others-list player-list)
            )
      (set! (-> body-group prim-core action) (collide-action solid deadly no-standon))
      (set-vector! (-> body-group local-sphere) 0.0 8192.0 0.0 12288.0)
      (set! (-> cshape root-prim) body-group)
      )
    (let ((legs-prim (new 'process 'collide-shape-prim-sphere cshape (the-as uint 0))))
      (set! (-> legs-prim prim-core collide-as) (collide-spec enemy))
      (set! (-> legs-prim prim-core collide-with)
            (collide-spec backgnd jak bot crate obstacle hit-by-others-list player-list)
            )
      (set! (-> legs-prim prim-core action) (collide-action solid deadly no-standon))
      (set-vector! (-> legs-prim local-sphere) 0.0 4096.0 0.0 3072.0)
      )
    (let ((torso-prim (new 'process 'collide-shape-prim-sphere cshape (the-as uint 0))))
      (set! (-> torso-prim prim-core collide-as) (collide-spec enemy))
      (set! (-> torso-prim prim-core collide-with)
            (collide-spec backgnd jak bot crate obstacle hit-by-others-list player-list)
            )
      (set! (-> torso-prim prim-core action) (collide-action solid deadly no-standon))
      (set-vector! (-> torso-prim local-sphere) 0.0 9830.4 0.0 3072.0)
      )
    ;; the attack sphere rides on the head joint
    (let ((head-prim (new 'process 'collide-shape-prim-sphere cshape (the-as uint 0))))
      (set! (-> head-prim prim-core collide-as) (collide-spec enemy))
      (set! (-> head-prim prim-core collide-with) (collide-spec jak bot player-list))
      (set! (-> head-prim prim-core action) (collide-action deadly))
      (set! (-> head-prim transform-index) 6)
      (set-vector! (-> head-prim local-sphere) 0.0 0.0 0.0 2048.0)
      )
    (set! (-> cshape nav-radius) 6144.0)
    (let ((root-prim (-> cshape root-prim)))
      (set! (-> cshape backup-collide-as) (-> root-prim prim-core collide-as))
      (set! (-> cshape backup-collide-with) (-> root-prim prim-core collide-with))
      )
    (set! (-> cshape max-iteration-count) (the-as uint 2))
    (set! (-> this root) cshape)
    )
  0
  (none)
  )

(defmethod init-enemy! ((this babak-enemy))
  "Typical place for shared init code. Runs from entity or process style init."
  (initialize-skeleton this *babak-enemy-sg* '())
  (setup-enemy! this *babak-enemy-nav-enemy-info*)
  (logior! (-> this skel status) (joint-control-status sync-math))
  (none)
  )
